{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codenotch",
  "version": "0.5.0",
  "identifier": "com.immidi.codenotch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Codenotch Settings",
        "url": "settings.html",
        "width": 520,
        "height": 620,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3OEZDOUQzQkY5NTc5Q0EKUldUS2VaVy8wOG1QWjJkUGNEOWFhY2puc09xT1Z1UEw5bHVlbXpySTg3TmV1UGxCRVpFR1VDd0MK",
      "endpoints": [
        "https://github.com/progh2/codenotch4win/releases/latest/download/latest.json"
      ]
    }
  }
}
